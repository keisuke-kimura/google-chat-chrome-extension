{
  "manifest_version": 3,
  "name": "Chat Booster for Google Chat",
  "version": "0.3.0",
  "description": "Google Chat をSlackライクに。Chat API でメンションを全スペース横断で検知して即通知し、未読の一覧とブックマーク保存ができます。",
  "minimum_chrome_version": "116",

  "permissions": [
    "identity",
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://chat.google.com/*",
    "https://mail.google.com/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Chat Booster（クリックでサイドパネル）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",

  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/chat/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "save-hovered-message": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "カーソル上（または選択中）のメッセージを保存"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      }
    }
  }
}
